# ─── Telegram Credentials ────────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Get API_ID and API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# ─── Access Control ──────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow all users (public bot).
ALLOWED_USERS=

# ─── Optional Dump Chat ───────────────────────────────────────────────────────
# Telegram chat/channel ID to mirror all uploaded files to.
DUMP_CHAT_ID=

# ─── JioHotstar Authentication ───────────────────────────────────────────────
# Path to a Netscape-format cookies file exported from your browser.
# Use "Get cookies.txt LOCALLY" browser extension.
JIOHOTSTAR_COOKIES=./hotstar.com_cookies.txt.txt

# ─── MX Player Authentication ────────────────────────────────────────────────
# Path to MX Player cookies file (usually not needed for free content).
MXPLAYER_COOKIES=

# ─── Google Drive Integration ────────────────────────────────────────────────
# Folder ID of target Google Drive folder (e.g. 1SQXO4uP3EWdhaAc8D907g1P3YgEhCVqR)
GDRIVE_FOLDER_ID=1SQXO4uP3EWdhaAc8D907g1P3YgEhCVqR
# Path to Google Service Account JSON file (optional)
GDRIVE_SA_FILE=./service_account.json

# ─── Download Settings ────────────────────────────────────────────────────────
DOWNLOAD_DIR=./downloads
MAX_FILESIZE_MB=1900
